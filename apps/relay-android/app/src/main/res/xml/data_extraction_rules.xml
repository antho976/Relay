<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and up. The replica is a copy of the PC's data and the pairing is this phone's own
    credential, so nothing goes to a cloud backup. A device-to-device transfer carries the settings
    but not the pairings (pc.preferences_pb, and cloud.preferences_pb for the server's copy) or the
    replica: the new phone pairs for itself and reads everything again from the PC.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="datastore/pc.preferences_pb" />
        <exclude domain="file" path="datastore/cloud.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
