<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone: the PC holds everything, and the pairing (pc.json, the phone's
     credential) must never be restored onto another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
