<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The owner's leaf-server: the library, covers and pages. No other host. Books come from the
         system's file picker, which needs no permission. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "Download Next up on Wi-Fi" asks whether the network is metered. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- New chapters of a series whose bell is on: an hourly job asks the server and posts a
         notice per new chapter run (Android 13+ asks the person first, the first time a bell is
         turned on). The job is kept across restarts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- App updates from the owner's server: a newer APK, downloaded and checked, is handed to
         Android's installer, which asks the person (the first time, Android asks whether Leaf may
         install apps at all). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Save picture puts it in Pictures/Leaf: Android 10 and later need nothing for that;
         Android 8 and 9 need this. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- Which apps open a web link (Webtoon's paid episodes: its app, else the browser), so
         LeafActivity.openUrl can tell when none does. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- Plain http is allowed: a server on the home network (192.168.x.x:4580) has no certificate.
         Leaf talks to the one server the person typed in, and nothing else. -->
    <application
        android:label="Leaf"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Leaf">
        <!-- The whole app is libleaf.so; LeafActivity (GameActivity, plus Back and the reader's
             full screen) hosts it and its keyboard. Every configuration change the app follows by
             itself is listed, so the activity is not recreated for them. -->
        <activity
            android:name="com.quietsoftware.leaf.LeafActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|smallestScreenSize|density|uiMode|navigation|fontScale|fontWeightAdjustment|locale|layoutDirection|colorMode|touchscreen|mcc|mnc|grammaticalGender">
            <meta-data android:name="android.app.lib_name" android:value="leaf" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A link or a title shared to Leaf (from a browser, or the Webtoon app): Search
                 opens with it. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <service
            android:name="com.quietsoftware.leaf.LeafChaptersJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
        <!-- Lends a book's notes (Markdown under the cache's shared/ folder) to the app picked in
             the share sheet, and an app update (the cache's updates/) to the installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
