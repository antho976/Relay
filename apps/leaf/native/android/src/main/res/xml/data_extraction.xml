<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing worth moving: the server holds the library and the place in each series; the page
     cache is fetched again. The server's address and token stay on this phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
