<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Edge to edge: the app draws under transparent bars and reads their insets. The window is
         Leaf's ground, so the first frame does not flash. -->
    <style name="Theme.Leaf" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
